configfile: "config/config.yaml"

SAMPLES = config["samples"]
READS = config["reads"]


rule all:
    input:
        expand(
            "results/raw_fastqc/{sample}_{read}_fastqc.html",
            sample=SAMPLES,
            read=READS
        ),
        expand(
            "results/trimmed/{sample}_{read}.fastq.gz",
            sample=SAMPLES,
            read=READS
        ),
        expand(
            "results/fastp/{sample}.{format}",
            sample=SAMPLES,
            format=["html", "json"]
        ),
        expand(
            "results/trimmed_fastqc/{sample}_{read}_trimmed_fastqc.html",
            sample=SAMPLES,
            read=READS
        ),
        expand(
            "results/aligned/{sample}.sorted.bam.bai",
            sample=SAMPLES
        ),
        "results/featurecounts/counts.txt",
        expand("results/kallisto/{sample}/abundance.tsv", sample=SAMPLES),
        expand("results/rseqc/bam_stat/{sample}.txt", sample=SAMPLES),
        expand("results/rseqc/infer_experiment/{sample}.txt", sample=SAMPLES),
        expand("results/rseqc/read_distribution/{sample}.txt", sample=SAMPLES),
        expand("results/rseqc/gene_body_coverage/{sample}.geneBodyCoverage.txt", sample=SAMPLES),
        expand("results/rseqc/inner_distance/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        expand("results/rseqc/inner_distance/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        "results/deeptools/correlation_heatmap.pdf",
        "results/deeptools/correlation_heatmap.pdf",
        "results/deeptools/pca.pdf"

rule fastqc_raw:
    input:
        "raw_data/fastq/{sample}_{read}.fastq"
    output:
        html="results/raw_fastqc/{sample}_{read}_fastqc.html",
        zip="results/raw_fastqc/{sample}_{read}_fastqc.zip"
    shell:
        """
        mkdir -p results/raw_fastqc
        fastqc --outdir results/raw_fastqc {input}
        """


rule fastp:
    input:
        r1="raw_data/fastq/{sample}_1.fastq",
        r2="raw_data/fastq/{sample}_2.fastq"
    output:
        r1="results/trimmed/{sample}_1.fastq.gz",
        r2="results/trimmed/{sample}_2.fastq.gz",
        html="results/fastp/{sample}.html",
        json="results/fastp/{sample}.json"
    threads: 4
    shell:
        """
        mkdir -p results/trimmed results/fastp
        fastp -i {input.r1} -I {input.r2} -o {output.r1} \
            -O {output.r2} -h {output.html} -j {output.json} \
            --thread {threads}
        """


rule fastqc_trimmed:
    input:
        "results/trimmed/{sample}_{read}.fastq.gz"
    output:
        html="results/trimmed_fastqc/{sample}_{read}_trimmed_fastqc.html",
        zip="results/trimmed_fastqc/{sample}_{read}_trimmed_fastqc.zip"
    shell:
        """
        mkdir -p results/trimmed_fastqc
        fastqc --outdir results/trimmed_fastqc {input}
        mv results/trimmed_fastqc/{wildcards.sample}_{wildcards.read}_fastqc.html \
           {output.html}
        mv results/trimmed_fastqc/{wildcards.sample}_{wildcards.read}_fastqc.zip \
           {output.zip}
        """


rule hisat2_index:
    input:
        config["genome_fasta"]
    output:
        expand(config["hisat2_index"] + ".{i}.ht2", i=range(1, 9))
    params:
        prefix=config["hisat2_index"]
    threads: 8
    conda: "../envs/align.yaml"
    log: "logs/hisat2/index.log"
    shell:
        "hisat2-build -p {threads} {input} {params.prefix} &> {log}"


rule hisat2_align:
    input:
        r1="results/trimmed/{sample}_1.fastq.gz",
        r2="results/trimmed/{sample}_2.fastq.gz",
        index=expand(config["hisat2_index"] + ".{i}.ht2", i=range(1, 9))
    output:
        "results/aligned/{sample}.sorted.bam"
    params:
        prefix=config["hisat2_index"]
    threads: 8
    conda: "../envs/align.yaml"
    log: "logs/hisat2/{sample}.log"
    shell:
        """
        hisat2 -p {threads} -x {params.prefix} -1 {input.r1} -2 {input.r2} 2> {log} \
            | samtools sort -@ {threads} -o {output} -
        """


rule samtools_index:
    input:
        "results/aligned/{sample}.sorted.bam"
    output:
        "results/aligned/{sample}.sorted.bam.bai"
    conda: "../envs/align.yaml"
    log: "logs/samtools_index/{sample}.log"
    shell:
        "samtools index {input} &> {log}"


rule featurecounts:
    input:
        bams=expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        gtf=config["gtf"]
    output:
        "results/featurecounts/counts.txt"
    threads: 8
    conda: "../envs/align.yaml"
    log: "logs/featurecounts.log"
    shell:
        "featureCounts -T {threads} -p --countReadPairs -s 0 -a {input.gtf} -o {output} {input.bams} &> {log}"

rule kallisto_index:
    input: config["transcriptome"]
    output: config["kallisto_index"]
    conda: "../envs/kallisto.yaml"
    log: "logs/kallisto/index.log"
    shell: "kallisto index -i {output} {input} &> {log}"


rule kallisto_quant:
    input:
        r1="results/trimmed/{sample}_1.fastq.gz",
        r2="results/trimmed/{sample}_2.fastq.gz",
        index=config["kallisto_index"]
    output: "results/kallisto/{sample}/abundance.tsv"
    params: outdir="results/kallisto/{sample}"
    threads: 8
    conda: "../envs/kallisto.yaml"
    log: "logs/kallisto/{sample}.log"
    shell:
        "kallisto quant -i {input.index} -o {params.outdir} -t {threads} {input.r1} {input.r2} &> {log}"

rule gtf_to_bed12:
    input:
        config["gtf"]
    output:
        config["bed12"]
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/gtf_to_bed12.log"
    shell:
        """
        gtfToGenePred {input} {output}.tmp &> {log}
        genePredToBed {output}.tmp {output} &>> {log}
        rm {output}.tmp
        """


rule bam_stat:
    input:
        "results/aligned/{sample}.sorted.bam"
    output:
        "results/rseqc/bam_stat/{sample}.txt"
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/bam_stat_{sample}.log"
    shell:
        "bam_stat.py -i {input} > {output} 2> {log}"


rule infer_experiment:
    input:
        bam="results/aligned/{sample}.sorted.bam",
        bed=config["bed12"]
    output:
        "results/rseqc/infer_experiment/{sample}.txt"
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/infer_experiment_{sample}.log"
    shell:
        "infer_experiment.py -i {input.bam} -r {input.bed} > {output} 2> {log}"

rule read_distribution:
    input:
        bam="results/aligned/{sample}.sorted.bam",
        bed=config["bed12"]
    output:
        "results/rseqc/read_distribution/{sample}.txt"
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/read_distribution_{sample}.log"
    shell:
        "read_distribution.py -i {input.bam} -r {input.bed} > {output} 2> {log}"

rule gene_body_coverage:
    input:
        bam="results/aligned/{sample}.sorted.bam",
        bai="results/aligned/{sample}.sorted.bam.bai",
        bed=config["bed_subset"]
    output:
        "results/rseqc/gene_body_coverage/{sample}.geneBodyCoverage.txt"
    params:
        prefix="results/rseqc/gene_body_coverage/{sample}"
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/gene_body_coverage_{sample}.log"
    shell:
        "geneBody_coverage.py -i {input.bam} -r {input.bed} -o {params.prefix} &> {log}"

rule bed_subset:
    input: config["bed12"]
    output: config["bed_subset"]
    log: "logs/rseqc/bed_subset.log"
    shell: "shuf -n 10000 --random-source=<(yes) {input} > {output} 2> {log}"

rule inner_distance:
    input:
        bam="results/aligned/{sample}.sorted.bam",
        bed=config["bed_subset"]
    output:
        "results/rseqc/inner_distance/{sample}.inner_distance_freq.txt"
    params:
        prefix="results/rseqc/inner_distance/{sample}"
    conda: "../envs/rseqc.yaml"
    log: "logs/rseqc/inner_distance_{sample}.log"
    shell:
        "inner_distance.py -i {input.bam} -r {input.bed} -o {params.prefix} &> {log}"

rule multibamsummary:
    input:
        bams=expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        bais=expand("results/aligned/{sample}.sorted.bam.bai", sample=SAMPLES)
    output:
        "results/deeptools/multiBamSummary.npz"
    params:
        labels=" ".join(SAMPLES)
    threads: 8
    conda: "../envs/deeptools.yaml"
    log: "logs/deeptools/multiBamSummary.log"
    shell:
        "multiBamSummary bins --bamfiles {input.bams} --labels {params.labels} -o {output} -p {threads} &> {log}"


rule plot_correlation:
    input:
        "results/deeptools/multiBamSummary.npz"
    output:
        plot="results/deeptools/correlation_heatmap.pdf",
        matrix="results/deeptools/correlation_matrix.tsv"
    conda: "../envs/deeptools.yaml"
    log: "logs/deeptools/plotCorrelation.log"
    shell:
        """
        plotCorrelation -in {input} --corMethod spearman --skipZeros \
            --whatToPlot heatmap --colorMap RdYlBu --plotNumbers \
            -o {output.plot} --outFileCorMatrix {output.matrix} &> {log}
        """

rule plot_pca:
    input:
        "results/deeptools/multiBamSummary.npz"
    output:
        plot="results/deeptools/pca.pdf",
        data="results/deeptools/pca_data.tsv"
    conda: "../envs/deeptools.yaml"
    log: "logs/deeptools/plotPCA.log"
    shell:
        "plotPCA -in {input} -o {output.plot} --outFileNameData {output.data} &> {log}"
